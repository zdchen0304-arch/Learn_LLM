# Copy to .env before starting Docker Compose. Do not commit the resulting .env file.
MAARS_PORT=3001
MAARS_SESSION_SECRET=replace-with-a-long-random-secret
MAARS_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
MAARS_BACKEND_LOG_LEVEL=INFO

# Gemini API credentials. Keep this file's values blank; put real values only
# in your ignored .env file. MAARS_MODEL defaults to gemini-2.5-flash if blank.
MAARS_API_KEY=
MAARS_MODEL=
# Reserved for provider-compatible deployments; the current client uses Gemini.
MAARS_API_BASE_URL=

# The default profile is safe for offline Mock mode. Enable Web only after review.
MAARS_TASK_WEB_ENABLED=0
MAARS_MOCK_STREAM_DELAY_MS=0
MAARS_MOCK_EXECUTION_PASS_PROBABILITY=1.0
MAARS_MOCK_VALIDATION_PASS_PROBABILITY=1.0

# This image is built with: docker compose --profile task-runtime build
MAARS_DOCKER_IMAGE=maars-task-python:local
